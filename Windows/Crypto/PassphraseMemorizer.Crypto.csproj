<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.6.2]" />
    <Compile Include="../../Signing/HybridSigner/Mldsa87.cs" Link="Reviewed/Mldsa87.cs" />
    <EmbeddedResource Include="Trust/rsa4096-spki.der" Condition="Exists('Trust/rsa4096-spki.der')" LogicalName="PassphraseMemorizer.Windows.RsaTrust" />
    <EmbeddedResource Include="Trust/mldsa87-public.bin" Condition="Exists('Trust/mldsa87-public.bin')" LogicalName="PassphraseMemorizer.Windows.MldsaTrust" />
  </ItemGroup>
</Project>
