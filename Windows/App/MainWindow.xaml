<Window x:Class="PassphraseMemorizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PassphraseMemorizer.App"
        Title="Passphrase Memorizer 1.0.1" Width="940" Height="880" MinWidth="820" MinHeight="740"
        Background="{StaticResource Background}" Foreground="White" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" Icon="Assets/AppIcon.png">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
    <StackPanel x:Name="Page" Margin="30,28">
      <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Image Source="Assets/AppIcon.png" Width="58" Height="58" Margin="0,0,16,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Passphrase Memorizer 1.0.1" FontWeight="Bold" FontSize="29" />
          <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource Subtitle}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Column="2" CornerRadius="10" Background="{StaticResource PanelStrong}" BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="3" VerticalAlignment="Center" Margin="10,0,0,0">
          <StackPanel Orientation="Horizontal"><RadioButton x:Name="English" Content="EN" GroupName="Language" IsChecked="True" Checked="LanguageChanged" AutomationProperties.Name="English" />
            <RadioButton x:Name="German" Content="DE" GroupName="Language" Checked="LanguageChanged" AutomationProperties.Name="Deutsch" /></StackPanel>
        </Border>
      </Grid>
      <Border Background="#0E3BE0C4" BorderBrush="#2E3BE0C4" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,20">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="●" Foreground="{StaticResource Teal}" FontSize="25" Margin="0,0,14,0" />
          <StackPanel Grid.Column="1"><TextBlock x:Name="IsolationTitle" Foreground="{StaticResource Teal}" FontWeight="SemiBold" />
            <TextBlock x:Name="IsolationText" Style="{StaticResource Subtitle}" Margin="0,6,0,0" /></StackPanel>
        </Grid>
      </Border>
      <Border Style="{StaticResource Section}"><StackPanel>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Step}"><TextBlock Text="01" Foreground="{StaticResource Teal}" FontWeight="Bold" /></Border>
          <StackPanel Grid.Column="1"><TextBlock x:Name="PhraseTitle" FontSize="18" FontWeight="Bold" /><TextBlock x:Name="PhraseSubtitle" Style="{StaticResource Subtitle}" Margin="0,3,0,0" /></StackPanel>
        </Grid>
        <Border CornerRadius="10" Background="{StaticResource PanelStrong}" BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="3">
          <UniformGrid Columns="2"><RadioButton x:Name="Bip39" Content="BIP39" GroupName="Format" IsChecked="True" Checked="FormatChanged" /><RadioButton x:Name="Eff" Content="EFF" GroupName="Format" Checked="FormatChanged" /></UniformGrid>
        </Border>
        <TextBlock x:Name="PhraseHelp" Style="{StaticResource Subtitle}" Margin="0,12" />
        <Border CornerRadius="12" Background="{StaticResource WordChip}" BorderBrush="{StaticResource Outline}" BorderThickness="1" Height="150" ClipToBounds="True">
          <Grid>
            <local:PrivateTextBox x:Name="PhraseInput" TextChanged="InputChanged" Background="Transparent" BorderThickness="0" Padding="12" Foreground="White" CaretBrush="White" FontFamily="Consolas" FontSize="15" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="8192" IsUndoEnabled="False" SpellCheck.IsEnabled="False" InputMethod.IsInputMethodEnabled="False" AllowDrop="False" />
            <StackPanel x:Name="InputCover" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="InputHiddenLabel" HorizontalAlignment="Center" Style="{StaticResource Subtitle}" FontWeight="SemiBold" /><Button x:Name="RevealInput" Click="InputVisibilityClicked" Margin="0,10,0,0" /></StackPanel>
          </Grid>
        </Border>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="WordCountLabel" FontWeight="SemiBold" /><TextBlock x:Name="ValidationLabel" Style="{StaticResource Subtitle}" Margin="0,5,12,0" /></StackPanel>
          <Button x:Name="InputVisibilityButton" Grid.Column="1" Click="InputVisibilityClicked" VerticalAlignment="Top" Margin="0,0,12,0" /><Button x:Name="ClearInputButton" Grid.Column="2" Style="{StaticResource DangerButton}" Click="ClearClicked" VerticalAlignment="Top" />
        </Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource Section}"><StackPanel>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Step}"><TextBlock Text="02" Foreground="{StaticResource Teal}" FontWeight="Bold" /></Border>
          <StackPanel Grid.Column="1"><TextBlock x:Name="ModelTitle" FontSize="18" FontWeight="Bold" /><TextBlock x:Name="ModelSubtitle" Style="{StaticResource Subtitle}" Margin="0,3,0,0" /></StackPanel>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0"><TextBlock x:Name="LocalModelLabel" FontWeight="SemiBold" /><TextBlock x:Name="ModelNameLabel" Style="{StaticResource Subtitle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxHeight="40" /><TextBlock x:Name="ModelPathHelp" Foreground="{StaticResource Muted}" Margin="0,4,0,0" /></StackPanel>
          <Button x:Name="ChooseModelButton" Grid.Column="1" Click="ChooseModelClicked" VerticalAlignment="Center" />
        </Grid>
        <Border CornerRadius="10" Background="{StaticResource PanelStrong}" BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="3" Margin="0,16,0,0">
          <UniformGrid Columns="5"><RadioButton x:Name="Rhyme" GroupName="Style" Checked="StyleChanged" /><RadioButton x:Name="Ballad" GroupName="Style" Checked="StyleChanged" /><RadioButton x:Name="Poem" GroupName="Style" Checked="StyleChanged" /><RadioButton x:Name="ShortStory" GroupName="Style" Checked="StyleChanged" IsChecked="True" /><RadioButton x:Name="Rap" GroupName="Style" Checked="StyleChanged" /></UniformGrid>
        </Border>
        <TextBlock x:Name="OutputLanguageHelp" Style="{StaticResource Subtitle}" Margin="0,8,0,16" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="GenerationLabel" Style="{StaticResource Subtitle}" /><ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Visibility="Collapsed" Height="3" Foreground="{StaticResource Teal}" Background="{StaticResource PanelStrong}" Margin="0,8,0,0" /></StackPanel>
          <Button x:Name="GenerateButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="GenerateClicked" />
          <Button x:Name="CancelButton" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource DangerButton}" Click="CancelClicked" />
        </Grid>
        <TextBlock x:Name="ErrorLabel" Foreground="{StaticResource Amber}" Margin="0,12,0,0" Visibility="Collapsed" />
      </StackPanel></Border>
      <Border x:Name="StorySection" Style="{StaticResource Section}" Visibility="Collapsed"><StackPanel>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Step}"><TextBlock Text="03" Foreground="{StaticResource Teal}" FontWeight="Bold" /></Border>
          <StackPanel Grid.Column="1"><TextBlock x:Name="StoryTitle" FontSize="18" FontWeight="Bold" /><TextBlock x:Name="StorySubtitle" Style="{StaticResource Subtitle}" Margin="0,3,0,0" /></StackPanel>
        </Grid>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="StoryStateLabel" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" /><Button x:Name="StoryVisibilityButton" Grid.Column="1" Click="StoryVisibilityClicked" Margin="0,0,12,0" /><Button x:Name="ClearStoryButton" Grid.Column="2" Style="{StaticResource DangerButton}" Click="ClearClicked" />
        </Grid>
        <Border CornerRadius="12" Background="{StaticResource WordChip}">
          <Grid><TextBlock x:Name="StoryHiddenHelp" Style="{StaticResource Subtitle}" Padding="16" />
            <ScrollViewer x:Name="StoryScroll" Visibility="Collapsed" Height="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:PrivateStoryText x:Name="StoryText" Foreground="White" TextWrapping="Wrap" FontSize="16" LineHeight="25" Padding="16" /></ScrollViewer>
          </Grid>
        </Border>
        <TextBlock x:Name="BackupHelp" Style="{StaticResource Subtitle}" Margin="0,12,0,0" />
      </StackPanel></Border>
      <StackPanel><Button x:Name="SecurityDetailsButton" Background="Transparent" BorderThickness="0" Padding="0,0,0,9" HorizontalAlignment="Left" Click="SecurityDetailsClicked" Foreground="{StaticResource Secondary}" />
        <TextBlock x:Name="SecuritySummary" Style="{StaticResource Subtitle}" /><TextBlock x:Name="SecurityDetails" Style="{StaticResource Subtitle}" Margin="0,9,0,0" Visibility="Collapsed" /></StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
